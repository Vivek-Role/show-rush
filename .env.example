# Copy to .env and fill in. Never commit .env.
# This file is the single source of truth for required variables —
# anything reading an env var not listed here is a bug.

# Server
NODE_ENV=development
PORT=3000

# Postgres — local Docker (Module 0.5) or Neon (Module 0.6)
# local:  postgres://showrush:showrush@localhost:5433/showrush
# Neon:   postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Redis — local Docker (Module 0.5) or Upstash (Module 0.6)
# local:    redis://localhost:6380
# Upstash:  rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# Auth (Module 1.3) — required. The server refuses to start without
# JWT_SECRET; there is no default, because a defaulted signing secret makes
# every token forgeable. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime. There are no refresh tokens — a known limitation.
JWT_EXPIRES_IN=7d

# Browser client (Module 3.1) — the exact origin the React client is served
# from, used as the CORS allow-origin. One origin, no wildcard: the client
# sends its session cookie on every request, and a wildcard origin is not
# permitted for credentialed requests.
#
#   vite dev:      http://localhost:5173
#   vite preview:  http://localhost:4173
#
# Unset means no browser client is allowed through. That is reported at
# startup, not fatal: curl and k6 are unaffected, because CORS is a rule
# browsers apply to themselves.
CLIENT_ORIGIN=http://localhost:5173

# Client-side variables are NOT listed here. Vite bakes them into the bundle at
# build time rather than reading them from a process, so they live beside the
# client — see client/.env.example.

# Booking path (Module 2.1) — 'safe' or 'naive'. Defaults to 'safe' when unset,
# so a forgotten variable can never serve the racy path.
#
#   safe   the transactional, constraint-backed path. Returns 501 until
#          Module 2.4 lands the UNIQUE (show_id, seat_id) constraint.
#   naive  a deliberately racy check-then-insert. It double-books seats under
#          concurrency, on purpose: it is the "before" in Phase 2's before/after
#          measurement. Enable it only for that controlled experiment, against a
#          local database. The server refuses to start with naive and
#          NODE_ENV=production.
BOOKING_MODE=safe

# Reconciliation (Module 6.2) — the sweep that expires unpaid bookings and
# gives their seats back. Until Phase 6 nothing ever released them, so a
# booking left unpaid claimed its seats forever.
#
# How long a booking may sit 'pending' before it is cancelled. Must exceed the
# 420-second hold TTL, or a booking could expire while its own hold is still
# live; the server refuses to start if it does not.
PENDING_BOOKING_TTL_SECONDS=900
# How often the in-process sweep runs.
#
#   0  disables the periodic sweep entirely. `npm run reconcile` still works.
#      Set this before a Phase 2 or Phase 5 benchmark: a background job
#      mutating bookings mid-run would measure something other than the code
#      under test.
RECONCILE_INTERVAL_SECONDS=60

# Observability (Phase 9 M2) — which instance wrote a log line.
#
# Every request produces one structured JSON line carrying a request id, the
# matched route pattern, status and duration. Unset is fine for a single
# process: the pid is used instead. It earns its keep in M3, where two or three
# instances write to the same place and "which one served this?" stops being
# obvious.
#
# p50/p95/p99 for the booking, hold, payment and availability paths are served
# at GET /metrics. That endpoint is refused with 404 when NODE_ENV=production,
# the same posture the payment simulation controls take.
INSTANCE_ID=

# Rate limiting on hold creation (M4) — one account must not hold a whole screen.
#
# HOLD_RATE_LIMIT is how many POST /api/shows/:id/holds requests one signed-in
# user may make per HOLD_RATE_WINDOW_SECONDS. Requests, not seats: the six-seat
# ceiling already bounds seats per request. Creation only — releasing a hold is
# never limited, because giving seats back is the way out of a mistake.
#
# Counted in Redis, so several instances share one budget rather than granting
# the limit each. A user over the limit gets 429 RATE_LIMITED and a Retry-After
# header. If Redis is unreachable the limiter allows the request through, and
# holds then fail with 503 HOLDS_UNAVAILABLE on their own.
#
# NOTE: 0 disables the limiter entirely, exactly as RECONCILE_INTERVAL_SECONDS=0
#       disables the sweep. Any hold benchmark must set HOLD_RATE_LIMIT=0 — a
#       load generator drives hundreds of requests a second as a single user, so
#       leaving the limiter on would measure the limiter.
HOLD_RATE_LIMIT=30
HOLD_RATE_WINDOW_SECONDS=60

# Virtual waiting room (BACKLOG.md P2) — a queue with a position, and a
# controlled admission rate, for a show that would otherwise be stormed.
#
# It protects capacity, not correctness: the unique constraint already makes a
# seat sell exactly once. This decides how many people per minute are allowed to
# start competing for seats, so the hold path sees a steady arrival rate.
#
# WAITING_ROOM_SHOWS is a comma-separated list of show ids. Empty — the default
# — means no show has a room, so nothing here changes existing behaviour. Only
# POST /api/shows/:id/holds is gated; browsing and reading a seat map stay open.
#
# Clients join with POST /api/shows/:id/queue and poll GET the same path,
# carrying their place in an X-Queue-Token header. Holding seats without an
# admitted ticket is refused with 403 QUEUE_REQUIRED or QUEUE_WAITING.
#
# Admission is computed from the queue's opening instant rather than advanced by
# a background job, so every instance agrees without coordination.
WAITING_ROOM_SHOWS=
WAITING_ROOM_RATE_PER_MINUTE=60
WAITING_ROOM_INITIAL_ADMIT=60
WAITING_ROOM_TICKET_TTL_SECONDS=1800

# Group booking constraints (BACKLOG.md P2) — the "no orphan seat" rule.
#
#   off         no seating rule; any available selection is accepted (default)
#   no-orphans  refuse a booking that would leave a single available seat with a
#               taken seat immediately on both sides, in the same row
#
# A lone seat at the end of a row or beside an aisle is NOT an orphan: the
# backlog's rule is "between bookings", and a wall is not a booking. A gap of
# two or more is fine — two people can sit there. Orphans that already exist are
# never held against the next booking; only newly created ones are refused, with
# 409 ORPHAN_SEAT.
#
# NOTE: off by default on purpose. It is a new way for a booking to be refused,
#       and Phase 2's before/after concurrency numbers are measured by booking
#       under contention — a second refusal path mixed into that run would
#       change what the number means.
#
# Advisory, not a guarantee: two bookings committing at the same instant each
# see the seating as it was before the other, so they can still leave an orphan
# between them. The unique constraint remains the only guarantee.
GROUP_BOOKING_RULE=off

# Cancellation + refund flow (BACKLOG.md P2) — how many minutes before a show
# starts cancellation stops being allowed.
#
# Measured against the show's start time, not against when the booking was made:
# that is the deadline a cinema actually enforces. A seat handed back two hours
# early can still be resold; one handed back as the lights go down cannot.
#
# POST /api/bookings/:ref/cancel cancels a whole booking. A 'pending' booking
# becomes 'cancelled'; a 'paid' one becomes 'refund_pending'. Either way the
# seats are archived to released_booking_seats with reason 'cancelled' and their
# booking_seats rows deleted, which is what actually puts them back on the map —
# UNIQUE (show_id, seat_id) has no predicate, so a status change alone would
# leave a seat that reads available and still refuses to be booked.
#
# NOTE: NOTHING IS REFUNDED. There is no payment provider in this build (a real
#       one is BACKLOG.md P1 and is deliberately not implemented), so
#       'refund_pending' records that a refund is owed and never that one
#       happened.
#
# 0 allows cancellation right up to the moment the show starts. There is no
# value that disables the endpoint: this is a policy, not a switch.
CANCELLATION_WINDOW_MINUTES=120
