# Copy to client/.env and fill in. Never commit client/.env.
#
# Client variables live here rather than in the repo-root .env because Vite
# bakes them into the bundle at build time — they are not read at runtime by a
# process, they are compiled into the JavaScript the browser downloads.
#
# Nothing secret may ever go in this file: everything here ships to the browser.

# Origin of the show-rush API. The production URL is never hard-coded in the
# client — it is supplied at build time by the deploy.
#   local dev:  http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Module 6.4 — how incoming seat updates reach the DOM. Both paths are real and
# both stay: the un-batched one is the "before" in this phase's measurement, and
# a before-number that cannot be re-run is a claim rather than a measurement.
# The same reasoning keeps BOOKING_MODE=naive alive on the server.
#
#   batched    buffer updates and flush once per animation frame (default)
#   immediate  apply every message as it arrives
VITE_SEAT_UPDATE_MODE=batched
